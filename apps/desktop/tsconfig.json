{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/navigation": ["./src/navigation.router.tsx"],
      "@/lib/nativeFs": ["./src/lib/nativeFs.ts"],
      "@/lib/detachedPreview": ["./src/lib/detachedPreview.ts"],
      "@/*": ["../web/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "tailwind.config.ts",
    "../web/src/components/**/*.ts",
    "../web/src/components/**/*.tsx",
    "../web/src/lib/**/*.ts",
    "../web/src/lib/**/*.tsx",
    "../web/src/store/**/*.ts",
    "../web/src/theme/**/*.ts",
    "../web/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "../web/src/lib/**/*.test.ts",
    "../web/src/lib/**/*.test.tsx",
    "../web/src/components/**/*.test.ts",
    "../web/src/components/**/*.test.tsx",
    "../web/src/lib/navigation.ts",
    "../web/src/lib/navigation.next.tsx",
    "../web/src/lib/nativeFs.ts",
    "../web/src/lib/detachedPreview.ts",
    "src/**/*.test.ts"
  ]
}
